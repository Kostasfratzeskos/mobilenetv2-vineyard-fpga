# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ── Datasets & large model artifacts (keep local / use Git LFS) ──
data/*
!data/README.md
!data/.gitkeep
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.onnx
*.tflite
#  ...except the one checkpoint everything is derived from, which goes in via
#  Git LFS. It was untracked, it was retrained on 2026-07-22 without the export
#  being regenerated, and the two silently disagreed for five weeks (DD-019).
#  The manifests carry its sha256 so a mismatch is caught, but catching it is
#  no use if nobody can obtain the file the hash names.
!software/runs/mobilenetv2_grape.pth
# Large exported weight blobs — track with Git LFS if you must version them:
# software/export/*.bin

