# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# The compiled manuscript. Rebuild it with `make`; committing it means every
# draft shows up as an unreviewable binary diff. Attach a PDF to a supervisor
# email instead, or tag a submission commit and build from the tag.
main.pdf

# Figures converted from the SVG sources by `make figures`. The SVGs are the
# source and ARE tracked; these are derived.
figures/*.pdf

# Generated by scripts/thesis_numbers.py. Derived from the manifest and the
# Vivado reports, so it is rebuilt rather than committed - and that way it can
# never disagree with the repository it describes.
generated/numbers.tex
