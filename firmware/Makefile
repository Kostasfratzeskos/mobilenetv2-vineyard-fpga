#=============================================================================
#  firmware/Makefile  -  the HOST build, which exists to run the tests
#
#  Same shape as software/cmodel/Makefile: src/ and test/, one program per test
#  file, .exe on Windows.
#
#  ---- what this Makefile does and does not build ----------------------
#
#  It builds the driver and the tests for a PC, with gcc. It does NOT build the
#  baremetal application - that needs a Vitis workspace with a standalone BSP
#  generated from build/bd_*/accel_bd_wrapper.xsa, an aarch64 cross compiler and
#  xilffs for the SD card. See README.md.
#
#  That split is the point rather than a limitation. accel_drv.c is portable C
#  with no Xilinx headers, talking to the hardware through five platform hooks,
#  precisely so that the part most likely to be wrong - the register map and the
#  order of operations - can be tested on a machine with no board attached.
#
#      make test      every test, and the lint below
#      make lint      compile-check the baremetal sources against stub headers
#      make           the same as `make test`
#
#  Neither test needs hardware, a bitstream, or Vivado.
#=============================================================================
CC      = gcc
CFLAGS  = -std=c11 -Wall -Wextra -O2 -MMD -MP -Iinclude
LDFLAGS =

SRC       = src
TESTDIR   = test
STUBS     = $(TESTDIR)/stubs
BUILD     = build
TESTBUILD = $(BUILD)/test

ifeq ($(OS),Windows_NT)
  EXE := .exe
else
  EXE :=
endif

#  main.c, img_src.c and plat_zynq.c are the baremetal side and cannot LINK on
#  the host - they need xilffs, xuartps and xil_cache from a Vitis BSP - so they
#  are excluded from the library. They are still COMPILE-checked, by `make lint`
#  below, which is a different thing and worth having: until that target existed
#  nothing on the host touched those ~600 lines at all, and the first time it ran
#  it found that main.c and plat_zynq.c could not compile AT ALL. Each had a glob
#  in a path inside a block comment - "build/bd_*/..." - and the "*/" in it closed
#  the comment, so the following prose was parsed as C. A Vitis build would have
#  been the first thing to notice.
LIB_SRCS  = $(SRC)/accel_drv.c $(SRC)/preproc.c
LIB_OBJS  = $(patsubst $(SRC)/%.c,$(BUILD)/%.o,$(LIB_SRCS))

TEST_SRCS = $(wildcard $(TESTDIR)/*.c)
TEST_BINS = $(patsubst $(TESTDIR)/%.c,$(TESTBUILD)/%$(EXE),$(TEST_SRCS))

#  The baremetal sources, and the stub headers that let them be compiled. The
#  stubs are declarations only and are NEVER linked - see test/stubs/README.md.
BM_SRCS   = $(SRC)/main.c $(SRC)/img_src.c $(SRC)/plat_zynq.c

.PHONY: all test lint clean
all: test

$(BUILD) $(TESTBUILD):
	@mkdir -p $@

$(BUILD)/%.o: $(SRC)/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

#  Explicit rules rather than one pattern, because the tests need different
#  things and saying so is clearer than a generic rule plus stubs.
#
#  test_csr_map compares the header against the RTL and touches no hardware at
#  all, so it must NOT link the driver - the driver's platform hooks are
#  undefined without a mock, and stubbing them just to satisfy the linker would
#  put dead code in a test whose whole job is to read a file.
$(TESTBUILD)/test_csr_map$(EXE): $(TESTDIR)/test_csr_map.c | $(TESTBUILD)
	$(CC) $(CFLAGS) $< -o $@ $(LDFLAGS)

#  test_drv_seq IS the driver's test, and supplies the five platform hooks
#  itself as a mock of the CSR (and, for accel_plat_phys, of an address map).
$(TESTBUILD)/test_drv_seq$(EXE): $(TESTDIR)/test_drv_seq.c $(LIB_OBJS) | $(TESTBUILD)
	$(CC) $(CFLAGS) $< $(LIB_OBJS) -o $@ $(LDFLAGS)

#  test_preproc links preproc.c and needs libm for lrint. -lm and not a hand-
#  rolled rounding helper: lrint is round-half-to-even in the default mode, which
#  is what torch.round does, and floor(x + 0.5) is a different function.
#
#  It reads software/golden/healthy_9111/000_rgb256.bin, which is generated by
#  `python scripts/gen_preproc_vectors.py`. If it is missing the test FAILS and
#  says so rather than skipping - a skipped front-end check is how "6,895,780
#  elements bit-exact" quietly stops covering the input tensor.
$(TESTBUILD)/test_preproc$(EXE): $(TESTDIR)/test_preproc.c $(BUILD)/preproc.o | $(TESTBUILD)
	$(CC) $(CFLAGS) $< $(BUILD)/preproc.o -o $@ $(LDFLAGS) -lm

#  -fsyntax-only, so no object files and no linker. -Wall -Wextra because the
#  point is to catch the things that are warnings rather than errors: an implicit
#  declaration, a dropped argument, a signature that drifted from its header.
lint:
	@echo "=============== lint: the baremetal sources ==============="
	$(CC) -std=c11 -Wall -Wextra -fsyntax-only -Iinclude -I$(STUBS) $(BM_SRCS)
	@echo "main.c, img_src.c and plat_zynq.c compile (stub headers, not linked)"
	@echo ""

test: lint $(TEST_BINS)
	@fail=0; \
	for t in $(TEST_BINS); do \
	    echo "=============== $$t ==============="; \
	    ./$$t || fail=1; \
	    echo ""; \
	done; \
	if [ $$fail -ne 0 ]; then echo ">> FIRMWARE TESTS FAILED"; exit 1; fi; \
	echo ">> all firmware tests pass"

clean:
	rm -rf $(BUILD)

-include $(wildcard $(BUILD)/*.d) $(wildcard $(TESTBUILD)/*.d)
